# Instagram Content Analyzer - example environment file
#
# Copy this file to ".env" and fill in real values.
# The ".env" file is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# Every key below is optional in Phase 1. They are declared now so that
# later phases can read them without changing the configuration layer.

# ---------------------------------------------------------------------
# General
# ---------------------------------------------------------------------

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Directory for generated JSON / reports
OUTPUT_DIR=output

# Directory for short-lived downloaded media (Phase 3+)
TEMP_DIR=temp

# ---------------------------------------------------------------------
# Extraction (Phase 3)
# ---------------------------------------------------------------------

# How the extractor authenticates:
#   public          - no Instagram session (default, no login needed)
#   browser_cookies - let yt-dlp borrow a local browser's cookies
#   cookie_file     - point yt-dlp at a local Netscape-format cookie file
# Only leave public unless public extraction is blocked because Instagram
# demands a login. No password is ever requested or stored in any mode.
EXTRACTION_MODE=public

# Browser to read cookies from when EXTRACTION_MODE=browser_cookies
# (e.g. chrome, firefox, edge, brave). Leave empty otherwise.
# NOTE: on some Windows setups Chrome cookie decryption fails with a DPAPI
# error; cookie_file mode is the fallback for that case.
COOKIES_FROM_BROWSER=

# Path to a local Netscape-format cookie file when
# EXTRACTION_MODE=cookie_file, e.g. secrets/instagram_cookies.txt
# The application passes only this PATH to yt-dlp. It never reads, prints,
# logs, copies or commits the cookie contents. This file is git-ignored and
# must stay private - never share or commit it. Leave empty otherwise.
COOKIE_FILE=

# ---------------------------------------------------------------------
# Phase 5 - Audio / Speech Understanding (local ASR, ₹0 cost)
# ---------------------------------------------------------------------

# Whisper model size: tiny, base, small, medium, large-v2, large-v3
# Larger = more accurate but slower and more memory.
# base is the recommended starting point for CPU inference.
ASR_MODEL_SIZE=base

# Device: cpu, cuda, auto
# Use cpu unless you have a CUDA-capable GPU with sufficient VRAM.
ASR_DEVICE=cpu

# Compute type: int8, float16, float32, int8_float16
# int8 is the fastest on CPU. Use float16 on GPU.
ASR_COMPUTE_TYPE=int8

# ---------------------------------------------------------------------
# API keys (unused so far - placeholders for later phases)
# ---------------------------------------------------------------------

# Multimodal synthesis / LLM calls
ANTHROPIC_API_KEY=

# Speech-to-text (NOT used by Phase 5 — local ASR only)
OPENAI_API_KEY=
